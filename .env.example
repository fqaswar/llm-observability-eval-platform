# Copy to .env and fill in. NEVER commit .env.
#
# Names matter: the Anthropic and Langfuse SDKs auto-read these exact variable
# names from the environment. CLAUDE_API_KEY / LANGFUSE_BASE_URL will NOT work.

# console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=

# Supabase -> Connect -> Session pooler URI (IPv4; the direct connection is
# IPv6-only on the free tier and fails from GitHub Actions).
#
# Replace the WHOLE [YOUR-PASSWORD] placeholder, brackets included. If your
# password contains any of these characters, percent-encode them or the URL
# parses wrongly:  @ -> %40   : -> %3A   / -> %2F   # -> %23
# e.g. password "Secret@123" becomes  ...:Secret%40123@aws-0-...
DATABASE_URL=

# cloud.langfuse.com -> your project -> Settings -> API Keys
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# https://cloud.langfuse.com (US) or https://eu.cloud.langfuse.com (EU)
LANGFUSE_HOST=https://cloud.langfuse.com

# ---- Tunables (optional; defaults shown in app/config.py) ----
# Phase 5 flips these to stage an eval regression.
# RAG_TOP_K=5
# RAG_MODEL=claude-haiku-4-5
